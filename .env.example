# Server-only MVP recognition mode. Set this to mock in Vercel Preview.
RECOGNITION_MODE=mock
# Set these only for RECOGNITION_MODE=real. Never use NEXT_PUBLIC_ prefixes.
VISION_PROVIDER=gemini
VISION_API_KEY=
VISION_MODEL=gemini-2.0-flash
# Production camera defaults to 8 seconds; the gated Vision Playground defaults to 20 seconds.
VISION_PROVIDER_TIMEOUT_MS=8000
VISION_EVALUATION_PROVIDER_TIMEOUT_MS=20000
# Applied only to Gemini models that support thinking controls (2.5/3.x).
VISION_THINKING_BUDGET=0
# Required to use /dev/vision-test in a production-like Preview environment.
VISION_PLAYGROUND_ENABLED=
# Preview / development QA only. Leave unset for the normal deterministic mug result.
# MOCK_RECOGNITION_SCENARIO=ambiguous
NEXT_PUBLIC_INSTANT_SCAN_OVERLAY=true
